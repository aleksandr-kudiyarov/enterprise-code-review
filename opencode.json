{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "code-review-orchestrator",
  "autoupdate": false,
  "mcp": {
    "gitlab": {
      "type": "remote",
      "url": "https://gitlab.sovcombank.group/api/v4/mcp",
      "enabled": false,
      "headers": {
        "X-Gitlab-Enabled-Mcp-Server-Toolsets": "core,merge_requests,repository,ci"
      },
      "timeout": 60000
    },
    "confluence": {
      "type": "remote",
      "url": "https://replace-with-approved-internal-confluence-mcp.example/mcp",
      "enabled": false,
      "timeout": 60000
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "ask",
    "external_directory": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "allow"
  },
  "agent": {
    "code-review-orchestrator": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "requirements-reviewer": "allow",
          "dotnet-reviewer": "allow",
          "postgresql-reviewer": "allow",
          "integration-reviewer": "allow",
          "findings-verifier": "allow"
        }
      }
    }
  }
}
